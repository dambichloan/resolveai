# Sao chép thành .env (KHÔNG commit). Chỉ dùng dữ liệu mẫu khi chạy bản miễn phí của Gemini.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=
EMBED_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
RAG_TOP_K=3
RAG_HANDOFF_THRESHOLD=0.65
RAG_ANSWER_THRESHOLD=0.70
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
ADMIN_BOOTSTRAP_USER=admin
# Bắt buộc đặt mật khẩu trước khi mở trang /admin/. Không commit tệp .env.
ADMIN_BOOTSTRAP_PASSWORD=
STAFF_SESSION_HOURS=8
# Kho KB, backup, Chroma và log đều nằm dưới DATA_DIR (volume Docker).
POLICIES_DIR=/var/lib/resolveai/policies
BACKUP_RETENTION_DAYS=7
TICKET_RETENTION_DAYS=365
TECHNICAL_LOG_RETENTION_DAYS=90
# Nhập giá hiện hành của model Gemini (USD/1 triệu token) để dashboard ước tính chi phí.
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0
COST_ALERT_DAILY_USD=5
COST_ALERT_PER_CONVERSATION_USD=0.05

RATE_LIMIT_PER_MIN=15
HOTLINE=
COOKIE_SECURE=0
TZ=Asia/Ho_Chi_Minh
# 1: nạp dữ liệu mẫu (phiên chat, Ticket, hàng đợi) để trang /admin/ có nội dung. Tắt khi chạy thật.
SEED_DEMO=1

# Ngưỡng llm_confidence: thấp hơn thì chuyển nhân viên (mặc định 0.70)
LLM_CONFIDENCE_THRESHOLD=0.70
# 1 = mở /mcp (JSON-RPC MCP: initialize, tools/list, tools/call) cho bốn công cụ; mặc định tắt
MCP_ENABLED=0
