# Sao chép thành .env (KHÔNG commit). Chỉ dùng dữ liệu mẫu khi chạy bản miễn phí của Gemini.
FAKE_LLM=1
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768
RAG_TOP_K=3
RAG_HANDOFF_THRESHOLD=0.65
RAG_ANSWER_THRESHOLD=0.70
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai
ADMIN_BOOTSTRAP_USER=admin
# Khóa cho API thêm/sửa/xóa chính sách trong /api/admin/policies.
# Để trống thì API này sẽ bị khóa thay vì mở công khai.
POLICY_ADMIN_KEY=

RATE_LIMIT_PER_MIN=15
HOTLINE=
COOKIE_SECURE=0
TZ=Asia/Ho_Chi_Minh
# 1: nạp dữ liệu mẫu (phiên chat, Ticket, hàng đợi) để trang /admin/ có nội dung. Tắt khi chạy thật.
SEED_DEMO=1
